APP_NAME=Diosmar Document Automation
DATABASE_URL=sqlite:///./diosmar.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# auto: etiquetas y, si faltan datos, Ollama. mock: solo etiquetas. ollama: solo modelo.
AI_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180

# mock: integración en el mismo proceso. http: requests con timeout a EXTERNAL_SYSTEM_URL.
EXTERNAL_SYSTEM_MODE=mock
EXTERNAL_SYSTEM_URL=http://127.0.0.1:8000/api/mock/admin/invoices
HTTP_TIMEOUT_SECONDS=10
